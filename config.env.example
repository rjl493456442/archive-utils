# Paths may be absolute or relative to this repository. This file is sourced by Bash.
GETH_BIN=./geth/build/bin/geth

# Mount both drives and create these data directories before starting.
DATADIR=
ANCIENT_DIR=
# Logs, reports, and the Prometheus database; choose a location on the SSD.
RUN_ROOT=

# Trusted mainnet block hash (0x + 64 hex digits), not a block number.
TARGET_HASH=

# Cache default for a 24 GiB RAM machine. This is not a process RSS cap.
CACHE_MB=4096
# Optional Go soft memory limit in MiB, e.g. 12288. Leave empty to omit --memorylimit.
MEMORY_LIMIT_MB=
